# Supabase project — Project Settings > API in the Supabase dashboard.
# PUBLISHABLE_KEY is the current name for what used to be called the "anon" key
# (safe to expose client-side, subject to RLS). All checkout writes go through
# security-definer RPCs (see supabase/migrations/0002_checkout_schema.sql), so
# a service-role key is deliberately never needed by the app itself.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paystack (wired in during the Cart & Checkout phase — unused for now)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend (transactional email — wired in during a later phase)
RESEND_API_KEY=
